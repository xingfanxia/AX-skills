{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/apple-photos-skill/schemas/event-v1.schema.json",
  "title": "Apple Photos JSONL event",
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "sequence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"enum": ["run_start", "asset", "album", "library", "resource", "item", "run_end"]},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "command": {"type": "string"},
    "observed_at": {"type": "string"},
    "status": {"type": "string"},
    "counts": {"type": "object"},
    "asset": {"type": "object"},
    "album": {"type": "object"},
    "library": {"type": "object"},
    "resource": {"type": "object"},
    "item": {"type": "object"}
  },
  "additionalProperties": false
}
